#!/bin/sh
set -eu

commit_msg_file=${1:-}

if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
  echo "commit-msg hook could not read the commit message file." >&2
  exit 1
fi

subject=$(grep -v '^[[:space:]]*#' "$commit_msg_file" | sed '/^[[:space:]]*$/d' | head -n 1 || true)

if [ -z "$subject" ]; then
  echo "Commit message subject cannot be empty." >&2
  exit 1
fi

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
    exit 0
    ;;
esac

if printf '%s\n' "$subject" | grep -Eq '^(feat|fix|refactor|docs|test|chore|ci|build|perf)(\([A-Za-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<'EOF'
Commit message must start with a supported Conventional Commits prefix.

Allowed examples:
  feat: add user-facing capability
  fix(scope): handle edge case
  refactor!: change internal API
  docs(readme)!: update setup instructions

Allowed types: feat, fix, refactor, docs, test, chore, ci, build, perf
EOF

exit 1
